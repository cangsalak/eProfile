// ================================================================
// Upload Module Schema
// Contains: MediaFile
// ================================================================

model MediaFile {
  id           String     @id @default(cuid())
  filename     String
  url          String
  size         Int
  mimetype     String
  module       String?    @default("upload")
  folder       String?    @default("general")
  uploadedById String?
  uploadedBy   Personnel? @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())
}
