// ================================================================
// Document Templates Module Schema
// ================================================================

model DocumentCategory {
  id          String   @id @default(cuid())
  name        String   // เช่น "หมวดใบลา", "หมวดเวรยาม"
  code        String   @unique // เช่น "LEAVES", "SHIFTS"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates   DocumentTemplate[]
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  categoryId  String
  category    DocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  name        String   // เช่น "ลาป่วย (แบบ ๔)"
  code        String   // รหัสอ้างอิง เช่น "LEAVE_SICK"
  
  pdfUrl      String?  // เก็บพาธไฟล์ PDF
  docxUrl     String?  // เก็บพาธไฟล์ DOCX
  
  isActive    Boolean  @default(true)
  mappingJson String?  // สำหรับการทำ Mapping พิกัด x, y ในอนาคต
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, code])
}
