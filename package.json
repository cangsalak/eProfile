{
  "name": "eprofile-system",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "npm run db:generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "ts-node -r dotenv/config -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\",\"jsx\":\"react\"}' tests/run-all.ts",
    "version:check": "node scripts/check-version.mjs",
    "db:merge": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/merge-schemas.ts",
    "db:generate": "npm run db:merge && node scripts/generate-schemas.js && prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/schema.mysql.prisma && prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:migrate": "npm run db:merge && prisma migrate dev",
    "db:migrate:deploy": "npm run db:merge && prisma migrate deploy",
    "db:push": "npm run db:merge && prisma db push",
    "db:studio": "npm run db:merge && prisma studio",
    "prisma:generate": "npm run db:generate",
    "prisma:migrate": "npm run db:migrate:deploy",
    "prisma:push": "npm run db:push",
    "prisma:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "prisma:seed-permissions": "npx tsx prisma/seed-permissions.ts",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs eprofile",
    "pm2:delete": "pm2 delete ecosystem.config.js"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@prisma/client": "^5.16.2",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.4.0",
    "isomorphic-dompurify": "^3.23.0",
    "jose": "^6.2.10",
    "jszip": "^3.10.1",
    "lru-cache": "^11.5.2",
    "lucide-react": "^0.408.0",
    "next": "14.2.5",
    "node-ical": "^0.27.1",
    "nodemailer": "^6.9.14",
    "qrcode.react": "^3.2.0",
    "react": "^18.3.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-webcam": "^7.2.0",
    "sharp": "^0.35.4",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.38",
    "prisma": "^5.16.2",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
