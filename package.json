{
  "name": "eprofile-system",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' tests/run-all.ts",
    "version:check": "node scripts/check-version.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "prisma:seed-permissions": "npx tsx prisma/seed-permissions.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.16.2",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.4.0",
    "isomorphic-dompurify": "^3.23.0",
    "jose": "^6.2.10",
    "jszip": "^3.10.1",
    "lru-cache": "^11.5.2",
    "lucide-react": "^0.408.0",
    "next": "14.2.5",
    "node-ical": "^0.27.1",
    "nodemailer": "^6.9.14",
    "qrcode.react": "^3.2.0",
    "react": "^18.3.1",
    "react-barcode": "^1.6.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-webcam": "^7.2.0",
    "sharp": "^0.35.4",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.38",
    "prisma": "^5.16.2",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
