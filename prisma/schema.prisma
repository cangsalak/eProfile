// Prisma Schema for eProfile System with Alpine OpenSSL support
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Personnel {
  id            String   @id @default(cuid())
  badgeNo       String   @unique
  username      String   @unique
  password      String
  role          String   @default("USER")
  prefix        String
  firstName     String
  lastName      String
  position      String
  department    String
  subDepartment String
  personnelType String   @default("นายทหารสัญญาบัตร") // Commissioned, NCO, Employee, Conscript, etc.
  phone         String
  mobile        String
  email         String
  status        String   @default("ปฏิบัติงานปกติ")
  avatarColor   String   @default("#3b82f6")
  skills        String   @default("[]")
  education     String   @default("")
  experience    String   @default("")
  notes                  String?
  citizenId              String   @default("")
  dateOfBirth            String   @default("")
  bloodType              String   @default("")
  religion               String   @default("")
  officialId             String   @default("")
  militaryBranch         String   @default("")
  commissionDate         String   @default("")
  currentAddress         String   @default("")
  currentTambon          String   @default("")
  currentAmphoe          String   @default("")
  currentProvince        String   @default("")
  currentZipcode         String   @default("")
  emergencyContactName   String   @default("")
  emergencyContactPhone  String   @default("")
  emergencyContactRelation String @default("")
  royalDecorations       String   @default("")
  trainingHistory        String   @default("")
  coverPhoto             String   @default("")
  profileTheme           String   @default("indigo")
  vehicles               Vehicle[]
  leaves                 LeaveRecord[]
  approvedLeaves         LeaveRecord[]        @relation("LeaveApprover")
  notifications          Notification[]
  notificationReads      NotificationRead[]
  posts                  Post[]
  auditLogs              AuditLog[]
  mediaFiles             MediaFile[]
  passwordResetTokens    PasswordResetToken[]
  documents              PersonnelDocument[]
  inspections            Inspection[]
  
  // Security Fields
  mustChangePassword     Boolean  @default(true)
  failedLoginAttempts    Int      @default(0)
  lockedUntil            DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Performance indexes
  @@index([department])
  @@index([subDepartment])
  @@index([status])
  @@index([personnelType])
  @@index([role])
  @@index([createdAt])
  @@index([firstName, lastName])
}

model Vehicle {
  id            String    @id @default(cuid())
  personnelId   String
  personnel     Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  type          String    // e.g. รถยนต์, รถจักรยานยนต์
  licensePlate  String
  brand         String
  model         String
  color         String
  photoFront    String?
  photoBack     String?
  photoSide     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LeaveRecord {
  id          String    @id @default(cuid())
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  leaveType   String    // ลากิจ, ลาป่วย, ลาไปบวช, ลาพักผ่อนประจำปี, อื่นๆ
  startDate      DateTime
  endDate        DateTime
  reason         String?
  writtenAt      String?   @default("ที่ว่าการอำเภอ/ค่าย/หน่วยงาน")
  toPerson       String?   // เรียนใคร
  contactAddress String?   // บ้านเลขที่, หมู่, ถนน
  contactTambon  String?   // ตำบล/แขวง
  contactAmphoe  String?   // อำเภอ/เขต
  contactProvince String?  // จังหวัด
  status         String    @default("รออนุมัติ") // รออนุมัติ, อนุมัติแล้ว, ไม่อนุมัติ, ยกเลิก
  
  // Approval / Review Tracking Fields
  approvedById    String?
  approvedBy      Personnel? @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  approvalNote    String?
  
  // Fields specifically for Annual Leave (ลาพักผ่อน)
  substitutePerson     String?   // ชื่อผู้รับมอบหน้าที่
  accumulatedLeaveDays Float?    // วันลาพักผ่อนสะสม (ยกมา)
  thisYearLeaveDays    Float?    // วันลาพักผ่อนประจำปี
  totalLeaveDays       Float?    // รวมวันลา
  
  // Fields specifically for Ordination Leave (ลาอุปสมบท)
  ordainedBefore       Boolean?  @default(false)
  ordainTempleName     String?
  ordainTempleLocation String?
  ordainDate           DateTime?
  stayTempleName       String?
  stayTempleLocation   String?
  
  // Fields specifically for Maternity Leave (ลาคลอดบุตร)
  maternityLeaveTimes  Int?
  maternityLeaveDays   Int?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([personnelId])
  @@index([status])
  @@index([approvedById])
  @@index([startDate, endDate])
}


model Department {
  id              String   @id @default(cuid())
  name            String   @unique
  shortName       String?  @default("")
  subDepartments  String   @default("[]") // JSON Array: [{ name: string, shortName?: string }]
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  type        String   @default("general") // 'general', 'operation', 'notification', 'meeting'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id          String     @id @default(cuid())
  personnelId String     // Target user ID, or 'ALL' for all users, or 'ADMIN' for all admins
  personnel   Personnel? @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String     @default("info") // 'info', 'success', 'warning', 'error'
  // NOTE: isRead is DEPRECATED for global notifications (personnelId='ALL'/'ADMIN').
  // Use the NotificationRead join table for per-user read state instead.
  isRead      Boolean    @default(false)
  link        String?
  createdAt   DateTime   @default(now())
  reads       NotificationRead[]

  @@index([personnelId])
  @@index([createdAt])
}

/// Per-user read-state for global (ALL/ADMIN) notifications.
/// Personal notifications (personnelId = real user ID) still use Notification.isRead directly.
model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  personnelId    String
  personnel      Personnel    @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, personnelId])
  @@index([personnelId])
}

model Post {
  id          String     @id @default(cuid())
  title       String
  content     String
  category    String?    @default("ข่าวทั่วไป")
  image       String?
  published   Boolean    @default(true)
  authorId    String
  author      Personnel  @relation(fields: [authorId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ContactMessage {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String
  status      String     @default("unread") // 'unread', 'read', 'replied'
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model AuditLog {
  id          String     @id @default(cuid())
  personnelId String?    // Who did the action
  personnel   Personnel? @relation(fields: [personnelId], references: [id])
  action      String     // 'CREATE', 'UPDATE', 'DELETE', 'LOGIN'
  entity      String     // 'Personnel', 'LeaveRecord', 'Post', 'SystemSetting'
  entityId    String?    // ID of the affected record
  details     String?    // JSON string of changes
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@index([action])
  @@index([personnelId])
  @@index([createdAt])
}

model MediaFile {
  id          String     @id @default(cuid())
  filename    String
  url         String
  size        Int
  mimetype    String
  uploadedById String?
  uploadedBy  Personnel? @relation(fields: [uploadedById], references: [id])
  createdAt   DateTime   @default(now())
}

model PasswordResetToken {
  id          String     @id @default(cuid())
  personnelId String
  personnel   Personnel  @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  token       String     @unique
  expiresAt   DateTime
  createdAt   DateTime   @default(now())
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  price       String?
  image       String?
  icon        String?  @default("fa-layer-group")
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemRole {
  id          String      @id @default(cuid())
  name        String      @unique // e.g. ADMIN, USER, HR_MANAGER
  displayName String      // e.g. ผู้ดูแลระบบ, ผู้ใช้งานทั่วไป, เจ้าหน้าที่บุคคล
  description String?
  permissions String      @default("[]") // JSON string of permissions like ["MANAGE_PERSONNEL", "APPROVE_LEAVE", "MANAGE_SYSTEM"]
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model PersonnelDocument {
  id          String    @id @default(cuid())
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  category    String    // คำสั่ง, บัตรประจำตัว, วุฒิการศึกษา, ใบประกาศ, ทะเบียนประวัติ, อื่นๆ
  filename    String
  mimeType    String
  size        Int
  storagePath String
  uploadedBy  String    @default("")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime?

  @@index([personnelId])
  @@index([category])
  @@index([createdAt])
}

model Inspection {
  id             String              @id @default(cuid())
  page           String
  url            String
  scanMode       String              @default("STANDARD") // QUICK, STANDARD, FULL
  userId         String
  user           Personnel           @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime            @default(now())
  completedAt    DateTime            @default(now())
  durationMs     Int                 @default(0)
  status         String              @default("COMPLETED") // COMPLETED, FAILED, RUNNING
  overallResult  String              @default("PASS") // PASS, NEEDS_REVIEW, CRITICAL_ISSUES
  criticalCount  Int                 @default(0)
  highCount      Int                 @default(0)
  mediumCount    Int                 @default(0)
  lowCount       Int                 @default(0)
  infoCount      Int                 @default(0)
  totalFindings  Int                 @default(0)
  findings       InspectionFinding[]
  createdAt      DateTime            @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([page])
}

model InspectionFinding {
  id             String     @id @default(cuid())
  inspectionId   String
  inspection     Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  findingCode    String     // e.g. UI-001, TX-002, AX-003
  category       String     // Typography, Accessibility, UI, Links, Images, Console, Form, SecurityHeaders, Performance
  severity       String     // CRITICAL, HIGH, MEDIUM, LOW, INFO
  title          String
  description    String
  expected       String?
  actual         String?
  element        String?
  selector       String?
  recommendation String
  status         String     @default("OPEN") // OPEN, REVIEWED, IGNORED, FIXED, FALSE_POSITIVE
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([inspectionId])
  @@index([severity])
  @@index([category])
  @@index([status])
}


