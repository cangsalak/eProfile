// ================================================================
// Contacts Module Schema
// Contains: ContactMessage
// ================================================================

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String
  status      String   @default("unread") // 'unread', 'read', 'replied'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
