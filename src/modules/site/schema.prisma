// ================================================================
// Site Module Schema
// Contains: Service
// ================================================================

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  price       String?
  image       String?
  icon        String?  @default("fa-layer-group")
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
